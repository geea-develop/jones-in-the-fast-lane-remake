{
  "name": "@jones/client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "postbuild": "node scripts/generate-precache-manifest.cjs",
    "start": "next start",
    "serve:out": "node scripts/serve-out.mjs",
    "test": "npm run test:unit --silent && npm run test:e2e --silent",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --config=playwright.config.ts"
  },
  "dependencies": {
    "@jones/shared": "*",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "20.14.12",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "10.4.19",
    "fast-check": "^4.10.0",
    "postcss": "^8.5.26",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.4",
    "vitest": "^4.1.11"
  }
}
